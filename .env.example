# LLM provider configuration (server-side only — never commit real keys)
# Defaults to the Lovable AI Gateway, which is pre-configured in this workspace.
LLM_BASE_URL=https://ai.gateway.lovable.dev/v1
LLM_MODEL=google/gemini-3.6-flash
# Bearer key for a custom OpenAI-compatible provider. Leave empty to use the
# managed gateway key (LOVABLE_API_KEY) that the platform injects.
Gemini_API_KEY=your_api_key_here
